# Copiez ce fichier vers .env.local et renseignez vos valeurs.

# --- Supabase (obligatoire) ---------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement, ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Divers (optionnel) -------------------------------------------------------
# URL publique de l'application (liens de réinitialisation de mot de passe).
NEXT_PUBLIC_APP_URL=
