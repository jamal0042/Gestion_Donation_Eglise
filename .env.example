# Copiez ce fichier vers .env.local et renseignez vos valeurs.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Connexion Google (optionnelle — sans ces valeurs, le bouton Google affiche un message de configuration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique de l'application (optionnelle — utilisée pour générer les liens de réinitialisation)
NEXT_PUBLIC_APP_URL=